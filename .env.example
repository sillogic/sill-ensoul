# sill-ensoul HTTP MCP server — 环境变量示例（SIL-7 远程部署）
#
# 远程部署时把这套变量配到运行服务的进程/服务上，不要写进代码、不要提交 git。
# 推荐写法：复制本文件为 /etc/sill-ensoul/env（root-only），systemd 用
# `EnvironmentFile=/etc/sill-ensoul/env` 读取 —— 见 deploy/sill-ensoul-http.service。
# 前台验证可先 export 到 shell（临时，重启 shell 即失效）。

# 【必设】Bearer token —— 远程鉴权唯一防线，fail-closed：缺它服务拒绝启动。
# 用强随机串生成，别手写：
#   openssl rand -hex 32
# 或 python -c "import secrets; print(secrets.token_hex(32))"
# 所有客户端（各 CLI 的 MCP 配置）必须填同一个值；泄露 = 换一个并重启服务。
ENSOUL_MCP_TOKEN=

# 【建议】服务器上记忆（knowledge/）根目录。
# 不设则走平台默认：Linux 下 ~/.local/share/ensoul/knowledge（H4/H9）。
# KB 迁移时把本地 knowledge/ 整目录复制到这里（排除 .fts 缓存）。
ENSOUL_KB=/opt/sill-ensoul/knowledge

# 【可选】绑定地址，默认 0.0.0.0（监听所有网卡）。
# 只想本机/内网访问就改成 127.0.0.1（防火墙/安全组只放行内网来源）。
# ENSOUL_MCP_HOST=0.0.0.0

# 【可选】监听端口，默认 8930。公网形态建议改高位随机端口，并在阿里云
# 安全组只放行该端口。
# ENSOUL_MCP_PORT=8930
